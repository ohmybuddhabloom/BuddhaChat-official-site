      "timeline": [
        {
          "year": "1880年",
          "text": "生于天津，俗名李叔同。"
        },
        {
          "year": "1905—1910年",
          "text": "赴日本学习美术与音乐，回国后从事艺术教育。"
        },
        {
          "year": "1918年",
          "text": "于杭州虎跑定慧寺出家。"
        },
        {
          "year": "闽南弘法时期",
          "text": "研究、讲授并整理南山律学，著述与书信记录其修学实践。"
        },
        {
          "year": "1942年",
          "text": "于泉州圆寂，留下悲欣交集等临终遗墨。"
        }
      ],
