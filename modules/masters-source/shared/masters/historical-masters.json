      "timeline": [
        {
          "year": "早年修学",
          "text": "于福建鼓山出家，后游方参学，重视禅修与戒律。"
        },
        {
          "year": "1930年代至1950年代",
          "text": "参与鼓山、南华、云门等祖庭的重兴，晚年驻锡云居山真如寺。"
        },
        {
          "year": "1953年",
          "text": "获推为中国佛教协会名誉会长。"
        },
        {
          "year": "1959年",
          "text": "于云居山真如寺圆寂。"
        }
      ],
