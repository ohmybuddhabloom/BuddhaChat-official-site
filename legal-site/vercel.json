{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "redirects": [
    {
      "source": "/",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/account-deletion.html",
      "destination": "/account-deletion",
      "permanent": true
    },
    {
      "source": "/support.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/child-safety.html",
      "destination": "/child-safety",
      "permanent": true
    },
    {
      "source": "/data-deletion",
      "destination": "/account-deletion",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/account-deletion",
      "destination": "/account-deletion.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/child-safety",
      "destination": "/child-safety.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
